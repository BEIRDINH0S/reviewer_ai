<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>com.reviewerai</groupId>
  <artifactId>ai-reviewer</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>AI Reviewer Java</name>
  <description>Relit le code d'une PR Java et signale les bugs potentiels</description>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Versions relevées sur Maven Central le 10/09/2026.
         Le numéro de JGit contient un suffixe de date : le recopier tel quel. -->
    <jgit.version>7.8.0.202609011348-r</jgit.version>
    <javaparser.version>3.28.2</javaparser.version>
    <jgrapht.version>1.5.3</jgrapht.version>
    <langchain4j.version>1.20.0</langchain4j.version>
    <jackson.version>2.22.2</jackson.version>
    <!-- 2.1.0 n'existe qu'en alpha : on garde la dernière 2.0.x stable. -->
    <slf4j.version>2.0.19</slf4j.version>
    <!-- JUnit 6 est disponible, mais change assez de choses pour ne pas valoir le risque
         sur un prototype d'une journée. La ligne 5.14 est stable et maintenue. -->
    <junit.version>5.14.4</junit.version>
  </properties>

  <dependencies>
    <!-- Brique Diff : lecture du diff git -->
    <dependency>
      <groupId>org.eclipse.jgit</groupId>
      <artifactId>org.eclipse.jgit</artifactId>
      <version>${jgit.version}</version>
    </dependency>

    <!-- Brique Graphe : parsing Java + résolution de symboles -->
    <dependency>
      <groupId>com.github.javaparser</groupId>
      <artifactId>javaparser-symbol-solver-core</artifactId>
      <version>${javaparser.version}</version>
    </dependency>

    <!-- Brique Graphe : structure de graphe -->
    <dependency>
      <groupId>org.jgrapht</groupId>
      <artifactId>jgrapht-core</artifactId>
      <version>${jgrapht.version}</version>
    </dependency>

    <!-- Brique LLM : appels au modèle local -->
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-ollama</artifactId>
      <version>${langchain4j.version}</version>
    </dependency>

    <!-- Brique LLM : validation stricte du JSON renvoyé par le modèle (cf. sécurité, injection de prompt) -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- Pas de dépendance pour la vue web : le serveur HTTP est celui du JDK
         (com.sun.net.httpserver), et Jackson, déjà présent, sert à produire le JSON. -->

    <!-- Logs (JGit et LangChain4j passent par slf4j) -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>ai-reviewer</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
      </plugin>

      <!-- Documentation publiée sur GitHub Pages : mvn javadoc:javadoc -> target/reports/apidocs -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.12.0</version>
        <configuration>
          <doclint>all,-missing</doclint>
          <notimestamp>true</notimestamp>
          <windowtitle>AI Reviewer — documentation</windowtitle>
          <doctitle>AI Reviewer</doctitle>
          <overview>${project.basedir}/src/main/javadoc/overview.html</overview>
        </configuration>
      </plugin>


      <!-- Produit un jar exécutable autonome : target/ai-reviewer.jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.reviewerai.Main</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
